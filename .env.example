# ==========================================
# CloudFace AI - Environment Variables Template
# ==========================================
# NEVER commit real credentials or secret keys to version control!

# Supabase / PostgreSQL Connection Strings
# Transaction Mode (with connection pooling, recommended for Vercel serverless)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session / Direct Mode (used by Prisma migrations and schema pushes)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Authentication & API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Supabase Secret / Service Role Key (SERVER ONLY - for admin provisioning script)
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"
